# Configuración de la Aplicación
PROJECT_NAME="EFI API CRUD"
API_V1_STR="/api/v1"
DEBUG=True

# Configuración de Base de Datos
# SQLite (por defecto para desarrollo local):
DATABASE_URL="sqlite:///./database.db"

# Si se usa PostgreSQL:
# DATABASE_URL="postgresql://usuario:password@localhost:5432/mi_base_datos"

# Si se usa MySQL:
# DATABASE_URL="mysql+pymysql://usuario:password@localhost:3306/mi_base_datos"

# Configuración de CORS (Orígenes permitidos separados por comas)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500"
